        function formatCompactIDR(val) {
            if (!val) return '0';
            if (val >= 1e9) return (val / 1e9).toFixed(2) + ' M';
            if (val >= 1e6) return (val / 1e6).toFixed(1) + ' Jt';
            if (val >= 1e3) return (val / 1e3).toFixed(0) + ' Rb';
            return val.toLocaleString('id-ID');
        }

