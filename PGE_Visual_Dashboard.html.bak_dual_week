                        <div class="lc-card-hint">
                            <i class="bi bi-arrows-angle-expand"></i> <span>Klik untuk Analisis Mendalam</span>
                        </div>
                    </div>
                `).join('');
        }

        // Sparkline Floating Tooltip Event Handlers
        function showSparklineTooltip(e, monthLabel, rawMonth, revFmt) {
            const tip = document.getElementById('sparklineFloatingTooltip');
            if (!tip) return;
            tip.innerHTML = `
                <div style="color: #94a3b8; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2px;">
                    📅 ${rawMonth} (${monthLabel})
                </div>
                <div class="mono" style="color: #38bdf8; font-weight: 800; font-size: 0.85rem;">
                    ${revFmt}
                </div>
            `;
            tip.style.display = 'block';
            moveSparklineTooltip(e);
        }

        function moveSparklineTooltip(e) {
            const tip = document.getElementById('sparklineFloatingTooltip');
            if (!tip) return;
            tip.style.left = e.clientX + 'px';
            tip.style.top = e.clientY + 'px';
        }

        function hideSparklineTooltip() {
            const tip = document.getElementById('sparklineFloatingTooltip');
            if (!tip) return;
            tip.style.display = 'none';
