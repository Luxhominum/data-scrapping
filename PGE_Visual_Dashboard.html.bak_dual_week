        function getComparisonBaseData() {
            const platformVal = document.getElementById('platformFilter') ? document.getElementById('platformFilter').value : 'ALL';
            const categoryVal = document.getElementById('categoryFilter') ? document.getElementById('categoryFilter').value : 'ALL';
            return tableData.filter(item => {
                if (platformVal !== 'ALL' && item.Platform !== platformVal) return false;
                if (categoryVal !== 'ALL' && item.Category !== categoryVal) return false;
                return true;
            });
        }

        function setMonthlyTrendMetric(metric) {
            activeMonthlyTrendMetric = metric;
            const btnRev = document.getElementById('btnMonthlyMetricRev');
            const btnQty = document.getElementById('btnMonthlyMetricQty');
            const btnOrd = document.getElementById('btnMonthlyMetricOrd');
            if (btnRev) btnRev.classList.toggle('active', metric === 'revenue');
            if (btnQty) btnQty.classList.toggle('active', metric === 'quantity');
            if (btnOrd) btnOrd.classList.toggle('active', metric === 'orders');
            renderCurrentMonthlyTrend();
        }

        function setMonthlyTrendMode(mode) {
            activeMonthlyTrendMode = mode;
            const btnTimeline = document.getElementById('btnMonthlyModeTimeline');
            const btnYoY = document.getElementById('btnMonthlyModeYoY');
            const btnManual = document.getElementById('btnMonthlyModeManual');
            const btnPlatform = document.getElementById('btnMonthlyModePlatform');

            if (btnTimeline) btnTimeline.classList.toggle('active', mode === 'timeline');
            if (btnYoY) btnYoY.classList.toggle('active', mode === 'yoy');
            if (btnManual) btnManual.classList.toggle('active', mode === 'manual');
            if (btnPlatform) btnPlatform.classList.toggle('active', mode === 'platform');
            
            const ctrlBox = document.getElementById('manualCompareControls');
            const deltaBox = document.getElementById('manualCompareDeltaBox');
            if (ctrlBox) ctrlBox.style.display = mode === 'manual' ? 'block' : 'none';
            if (deltaBox) deltaBox.style.display = mode === 'manual' ? 'block' : 'none';

            renderCurrentMonthlyTrend();
        }

        function swapManualCompareMonths() {
            const compA = document.getElementById('manualCompareMonthA');
            const compB = document.getElementById('manualCompareMonthB');
            if (compA && compB) {
                const temp = compA.value;
                compA.value = compB.value;
                compB.value = temp;
                renderCurrentMonthlyTrend();
            }
        }

        function renderCurrentMonthlyTrend() {
            const chartEl = document.querySelector("#monthlyTrendChart");
            if (!chartEl) return;

            const ctrlBox = document.getElementById('manualCompareControls');
            const deltaBox = document.getElementById('manualCompareDeltaBox');

            if (trendChart) {
                try {
                    trendChart.destroy();
                } catch(e) {}
                trendChart = null;
            }
            chartEl.innerHTML = '';

            const compData = getComparisonBaseData();

            // Metric Configuration
            let metricKey = 'Revenue';
            let metricLabel = 'Pendapatan (IDR)';
            let metricSuffix = '(IDR)';
            let valFormatter = val => formatIDR(val);
            let axisFormatter = val => formatIDRCompact(val);

            if (activeMonthlyTrendMetric === 'quantity') {
                metricKey = 'Quantity';
                metricLabel = 'Unit Terjual (Pcs)';
                metricSuffix = '(Pcs)';
                valFormatter = val => Math.round(val).toLocaleString('id-ID') + ' pcs';
                axisFormatter = val => Math.round(val).toLocaleString('id-ID');
            } else if (activeMonthlyTrendMetric === 'orders') {
                metricKey = 'Orders';
                metricLabel = 'Jumlah Pesanan';
                metricSuffix = '(Pesanan)';
                valFormatter = val => Math.round(val).toLocaleString('id-ID') + ' pesanan';
                axisFormatter = val => Math.round(val).toLocaleString('id-ID');
            }

            if (activeMonthlyTrendMode === 'manual') {
                if (ctrlBox) ctrlBox.style.display = 'block';
                if (deltaBox) deltaBox.style.display = 'block';

                const rawSlots = [
                    { id: 1, name: 'Periode 1 (Basis)', shortName: 'P1', color: '#f59e0b', bgLight: '#fef3c7', borderLight: '#fde68a', month: document.getElementById('manualCompareMonth1') ? document.getElementById('manualCompareMonth1').value : '2023-01' },
