                    if (activeRetentionTier === 'Wholesale' && !item.tier.includes('Wholesale')) return false;
                    if (activeRetentionTier === 'VIP' && !item.tier.includes('VIP')) return false;
                    if (activeRetentionTier === 'Loyal' && !item.tier.includes('Loyal')) return false;
                    if (activeRetentionTier === 'Regular' && !item.tier.includes('Regular')) return false;
                    if (activeRetentionTier === 'First Repeat' && !item.tier.includes('First Repeat')) return false;
                }
                // Platform filter
                if (platform !== 'ALL') {
                    if (!item.platforms.includes(platform)) return false;
                }
                // Year filter
                if (yearFilter !== 'ALL') {
                    if (yearFilter === 'MULTI') {
                        if (!item.multi_year) return false;
                    } else {
                        const targetY = parseInt(yearFilter);
                        if (!item.years || !item.years.includes(targetY)) return false;
                    }
                }
                // Search query
                if (query) {
                    const matchName = item.name.toLowerCase().includes(query);
                    const matchCity = item.city.toLowerCase().includes(query);
                    const matchProd = item.sample_prod.toLowerCase().includes(query);
                    if (!matchName && !matchCity && !matchProd) return false;
                }
                return true;
            });

            // Apply column sorting
            const tierWeight = {
                'Wholesale (>25x)': 5,
