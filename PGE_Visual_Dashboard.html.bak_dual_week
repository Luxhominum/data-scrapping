                const isTop = rankIdx === 0 && !isZero;
                return `
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 2.5px 0; border-bottom: 1px dashed #f1f5f9; opacity: ${isZero ? '0.45' : '1'};">
