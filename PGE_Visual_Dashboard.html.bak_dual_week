        // Render Category Summary Matrix with In-Table Accordion Rows
        function renderCategoryMatrixAndAccordions(filtered) {
            const totalNet = filtered.reduce((a, b) => a + (b.Revenue || 0), 0);
            const matrixBody = document.getElementById('categoryMatrixBody');
            if (!matrixBody) return;
            const allMonths = [...new Set(filtered.map(d => d.Month))].sort();

            const rows = CATEGORIES_LIST.map(cat => {
                const catItems = filtered.filter(d => d.Category === cat);
                const rev = catItems.reduce((a, b) => a + (b.Revenue || 0), 0);
                const qty = catItems.reduce((a, b) => a + (b.Quantity || 0), 0);
                const ord = catItems.reduce((a, b) => a + (b.Orders || 0), 0);
                const share = totalNet > 0 ? ((rev / totalNet) * 100).toFixed(1) : 0;
                const aov = ord > 0 ? (rev / ord) : 0;

                // Monthly breakdown for this category
                const monthBreakdown = allMonths.map((m, idx) => {
                    const mItems = catItems.filter(d => d.Month === m);
                    const mRev = mItems.reduce((a, b) => a + (b.Revenue || 0), 0);
                    const mQty = mItems.reduce((a, b) => a + (b.Quantity || 0), 0);
                    const mOrd = mItems.reduce((a, b) => a + (b.Orders || 0), 0);

                    // Prev month for MoM
                    const prevM = allMonths[idx - 1];
                    let momBadge = '<span class="text-muted small">-</span>';
                    if (prevM) {
                        const prevMRev = catItems.filter(d => d.Month === prevM).reduce((a, b) => a + (b.Revenue || 0), 0);
                        if (prevMRev > 0) {
                            const diffPct = (((mRev - prevMRev) / prevMRev) * 100).toFixed(1);
                            const isUp = diffPct >= 0;
                            momBadge = `<span class="badge ${isUp ? 'bg-success' : 'bg-danger'} mono" style="font-size: 0.72rem;">${isUp ? '+' : ''}${diffPct}%</span>`;
                        } else if (mRev > 0) {
                            momBadge = `<span class="badge bg-primary mono" style="font-size: 0.72rem;">Baru</span>`;
                        }
                    }

                    const totalMonthRev = filtered.filter(d => d.Month === m).reduce((a, b) => a + (b.Revenue || 0), 0);
                    const mShare = totalMonthRev > 0 ? ((mRev / totalMonthRev) * 100).toFixed(1) : 0;

                    return { month: m, rev: mRev, qty: mQty, ord: mOrd, momBadge, share: mShare };
                }).filter(m => m.rev > 0);

                return { cat, rev, qty, ord, share, aov, monthBreakdown };
            }).sort((a, b) => b.rev - a.rev);

            let tableHtml = '';
            rows.forEach((r, idx) => {
                const accId = `cat-acc-subrow-${idx}`;
                tableHtml += `
                    <tr style="cursor: pointer;" onclick="toggleCategoryAccordion('${accId}', this)" title="Klik untuk melihat rincian bulan ke bulan kategori ${r.cat}">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-chevron-right acc-cat-icon text-primary fw-bold" style="transition: transform 0.2s ease;"></i>
                                <span class="cat-pill ${getCategoryPillClass(r.cat)}">${r.cat}</span>
                                <span class="badge bg-light text-secondary border small fw-normal" style="font-size: 0.70rem;">${r.monthBreakdown.length} Bulan Aktif</span>
                                <button class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold ms-auto" style="font-size: 0.70rem;" onclick="event.stopPropagation(); inspectCategoryProducts('${r.cat}')" title="Buka produk kategori ${r.cat} di tabel penjelajah di bawah">
                                    <i class="bi bi-box-seam me-1"></i>Lihat Produk
                                </button>
                            </div>
                        </td>
                        <td class="text-end mono fw-bold text-success">${formatIDR(r.rev)}</td>
                        <td class="text-end mono fw-bold text-dark">${r.share}%</td>
                        <td class="text-end mono text-secondary">${r.qty.toLocaleString('id-ID')}</td>
                        <td class="text-end mono text-secondary">${r.ord.toLocaleString('id-ID')}</td>
                        <td class="text-end mono fw-semibold text-dark">${formatIDR(r.aov)}</td>
                    </tr>
                    <tr id="${accId}" style="display: none; background-color: #f8fafc;">
                        <td colspan="6" class="p-3 border-bottom border-primary">
                            <div class="p-3 bg-white rounded-3 border shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div class="fw-bold text-primary small">
                                        <i class="bi bi-calendar3 me-1"></i> Rincian Bulan-ke-Bulan (MoM) untuk Kategori: <span class="text-dark fw-bold">${r.cat}</span>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary fw-bold mono small">Total Omzet: ${formatIDR(r.rev)}</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 0.82rem;">
                                        <thead class="table-light">
                                            <tr class="text-secondary small fw-bold">
                                                <th>Periode Bulan</th>
                                                <th class="text-end">Pendapatan (IDR)</th>
                                                <th class="text-center">Pertumbuhan MoM</th>
                                                <th class="text-end">Pangsa di Bulan Itu (%)</th>
                                                <th class="text-end">Unit Terjual</th>
                                                <th class="text-end">Jumlah Pesanan</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            ${r.monthBreakdown.map(m => `
                                                <tr>
                                                    <td class="mono fw-bold text-dark"><i class="bi bi-calendar-check me-1 text-muted"></i>${m.month} (${formatMonthLabel(m.month)})</td>
                                                    <td class="text-end mono fw-bold text-success">${formatIDR(m.rev)}</td>
                                                    <td class="text-center">${m.momBadge}</td>
                                                    <td class="text-end mono fw-bold text-dark">${m.share}%</td>
                                                    <td class="text-end mono text-secondary">${m.qty.toLocaleString('id-ID')}</td>
                                                    <td class="text-end mono text-secondary">${m.ord.toLocaleString('id-ID')}</td>
                                                </tr>
                                            `).join('')}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                `;
            });

            matrixBody.innerHTML = tableHtml;

            // Also refresh Category Product Inspector
            renderCategoryProductInspector();
        }

        function toggleCategoryAccordion(id, el) {
            const subrow = document.getElementById(id);
            const icon = el.querySelector('.acc-cat-icon');
            if (subrow.style.display === 'none' || subrow.style.display === '') {
                subrow.style.display = 'table-row';
                if (icon) {
                    icon.className = 'bi bi-chevron-down acc-cat-icon text-primary fw-bold';
                }
                el.style.backgroundColor = '#f1f5f9';
            } else {
                subrow.style.display = 'none';
                if (icon) {
                    icon.className = 'bi bi-chevron-right acc-cat-icon text-primary fw-bold';
                }
                el.style.backgroundColor = '';
            }
        }

