            setTimeout(() => {
                const tip = document.querySelector('#categoryTrendChart .apexcharts-tooltip');
                if (tip) {
                    if (isLeftHalf) {
                        tip.style.setProperty('left', 'auto', 'important');
                        tip.style.setProperty('right', '25px', 'important');
                        tip.style.setProperty('top', '25px', 'important');
                        tip.style.setProperty('transform', 'none', 'important');
