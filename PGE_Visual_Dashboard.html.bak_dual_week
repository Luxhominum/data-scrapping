                                <span class="cat-pill ${getCategoryPillClass(p.category)}" style="font-size: 0.65rem;">${p.category}</span>
                                <span class="lc-tag ${p.tagClass}">${p.tag}</span>
                            </div>
                            <h6 class="fw-bold mb-1" style="font-size: 0.85rem; line-height: 1.35; color: #0f172a;" title="${p.name.replace(/"/g, '&quot;')}">${cleanShortTitle(p.name)}</h6>
                            <div class="mono fw-bold text-success" style="font-size: 0.95rem;">${p.totalDisplay}</div>
                            
                            <!-- Peak Spike Badge -->
                            <div class="mt-2 d-flex align-items-center gap-1">
