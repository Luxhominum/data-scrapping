                    { id: 4, name: 'Periode 4', shortName: 'P4', color: '#8b5cf6', bgLight: '#f3e8ff', borderLight: '#ddd6fe', month: document.getElementById('manualCompareMonth4') ? document.getElementById('manualCompareMonth4').value : '2026-01' }
