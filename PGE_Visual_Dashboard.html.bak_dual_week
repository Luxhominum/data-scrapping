                        elActiveCats.textContent = '17 Lini Master Aktif';
                    } else if (count === 1) {
                        const singleCat = Array.from(activeCatsSet)[0];
                        elActiveCats.textContent = `1 Lini: ${singleCat.length > 20 ? singleCat.slice(0, 18) + '...' : singleCat}`;
