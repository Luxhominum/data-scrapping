            currentParetoClassified = classified;

            // Populate Pareto Category Filter options if not already populated
            const catSelect = document.getElementById('paretoCategoryFilter');
            if (catSelect && catSelect.options.length <= 1) {
                CATEGORIES_LIST.forEach(cat => {
