        // Export to CSV
        function exportFilteredCSV() {
            const filtered = getFilteredData();
            if (!filtered || filtered.length === 0) {
                alert('Tidak ada data yang tersedia untuk diekspor.');
                return;
            }

            const headers = ['Tahun', 'Bulan', 'Platform', 'Kategori', 'Nama_Produk', 'Variasi', 'Kuantitas_Unit', 'Jumlah_Pesanan', 'Pendapatan_Bersih_IDR'];
            let csvContent = 'data:text/csv;charset=utf-8,' + headers.join(',') + '\n';

            filtered.forEach(row => {
                const escapedName = '"' + (row.Product_Name || '').replace(/"/g, '""') + '"';
                const escapedVar = '"' + (row.Variation || '').replace(/"/g, '""') + '"';
                const line = [
                    row.Year,
                    row.Month,
                    row.Platform,
                    row.Category,
                    escapedName,
                    escapedVar,
                    row.Quantity,
                    row.Orders,
                    row.Revenue
                ].join(',');
                csvContent += line + '\n';
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement('a');
            link.setAttribute('href', encodedUri);
            link.setAttribute('download', `PGE_Ekspor_Penjualan_${new Date().toISOString().slice(0, 10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }


