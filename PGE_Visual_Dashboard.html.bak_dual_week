        // 1. Pareto ABC (80/20) Concentration Analysis
        function renderParetoAnalysis(filtered) {
            const prodMap = {};
            filtered.forEach(d => {
                const name = d.Product_Name || 'Unknown';
                if (!prodMap[name]) prodMap[name] = { name: name, category: d.Category, revenue: 0, units: 0, orders: 0 };
                prodMap[name].revenue += (d.Revenue || 0);
                prodMap[name].units += (d.Quantity || 0);
                prodMap[name].orders += (d.Orders || 0);
            });

            function getMetricVal(p) {
                if (activeParetoMetric === 'Quantity') return p.units || 0;
                if (activeParetoMetric === 'Orders') return p.orders || 0;
                return p.revenue || 0;
            }

            const sortedProds = Object.values(prodMap).sort((a, b) => getMetricVal(b) - getMetricVal(a));
            const totalMetric = sortedProds.reduce((a, b) => a + getMetricVal(b), 0);

            let runningSum = 0;
            let countA = 0, countB = 0, countC = 0;
            let valA = 0, valB = 0, valC = 0;

            const classified = sortedProds.map((p, idx) => {
                const metricVal = getMetricVal(p);
                runningSum += metricVal;
                const cumPct = totalMetric > 0 ? (runningSum / totalMetric) * 100 : 0;
                let abcClass = 'C';
                let badgeClass = 'bg-danger';

                if (cumPct <= 80 || (idx === 0 && cumPct > 80)) {
                    abcClass = 'A';
                    badgeClass = 'bg-success';
                    countA++;
                    valA += metricVal;
                } else if (cumPct <= 95) {
                    abcClass = 'B';
                    badgeClass = 'bg-primary';
                    countB++;
                    valB += metricVal;
                } else {
                    abcClass = 'C';
                    badgeClass = 'bg-danger';
                    countC++;
                    valC += metricVal;
                }

                return { ...p, rank: idx + 1, metricVal, cumPct: cumPct.toFixed(1), abcClass, badgeClass };
            });

            // Format metric display helper
            function formatMetricDisplay(val) {
                if (activeParetoMetric === 'Quantity') return Math.round(val).toLocaleString('id-ID') + ' pcs';
                if (activeParetoMetric === 'Orders') return Math.round(val).toLocaleString('id-ID') + ' pesanan';
                return formatIDR(val);
            }

            function formatMetricCompact(val) {
                if (activeParetoMetric === 'Quantity') {
                    if (val >= 1000000) return (val / 1000000).toFixed(1) + 'M pcs';
                    if (val >= 1000) return (val / 1000).toFixed(1) + 'k pcs';
                    return Math.round(val).toLocaleString('id-ID') + ' pcs';
                }
                if (activeParetoMetric === 'Orders') {
                    if (val >= 1000) return (val / 1000).toFixed(1) + 'k order';
                    return Math.round(val).toLocaleString('id-ID') + ' order';
                }
                return formatIDRCompact(val);
            }

            // Update 3 ABC Metric Cards
            const cardARev = document.getElementById('paretoCardARev');
            const cardACount = document.getElementById('paretoCardACount');
            const cardAShare = document.getElementById('paretoCardAShare');
            const cardAPct = document.getElementById('paretoCardAPct');
            if (cardARev) cardARev.textContent = formatMetricDisplay(valA);
            if (cardACount) {
                if (activeParetoMetric === 'Quantity') cardACount.textContent = `${countA.toLocaleString('id-ID')} Produk Volume Inti`;
                else if (activeParetoMetric === 'Orders') cardACount.textContent = `${countA.toLocaleString('id-ID')} Produk Paling Sering Dipesan`;
                else cardACount.textContent = `${countA.toLocaleString('id-ID')} Produk Cash Cow`;
            }
            if (cardAShare) cardAShare.textContent = `${sortedProds.length > 0 ? ((countA / sortedProds.length) * 100).toFixed(1) : 0}% dari Total Katalog`;
            if (cardAPct) {
                if (activeParetoMetric === 'Quantity') cardAPct.textContent = '~80% Volume Gudang';
                else if (activeParetoMetric === 'Orders') cardAPct.textContent = '~80% Checkout Pembeli';
                else cardAPct.textContent = '~80% Omzet';
            }

            const cardBRev = document.getElementById('paretoCardBRev');
            const cardBCount = document.getElementById('paretoCardBCount');
            const cardBShare = document.getElementById('paretoCardBShare');
            const cardBPct = document.getElementById('paretoCardBPct');
            if (cardBRev) cardBRev.textContent = formatMetricDisplay(valB);
            if (cardBCount) cardBCount.textContent = `${countB.toLocaleString('id-ID')} Produk Regular`;
            if (cardBShare) cardBShare.textContent = `${sortedProds.length > 0 ? ((countB / sortedProds.length) * 100).toFixed(1) : 0}% dari Total Katalog`;
            if (cardBPct) {
                if (activeParetoMetric === 'Quantity') cardBPct.textContent = '~15% Volume Gudang';
                else if (activeParetoMetric === 'Orders') cardBPct.textContent = '~15% Checkout Pembeli';
                else cardBPct.textContent = '~15% Omzet';
            }

            const cardCRev = document.getElementById('paretoCardCRev');
            const cardCCount = document.getElementById('paretoCardCCount');
            const cardCShare = document.getElementById('paretoCardCShare');
            const cardCPct = document.getElementById('paretoCardCPct');
            if (cardCRev) cardCRev.textContent = formatMetricDisplay(valC);
            if (cardCCount) cardCCount.textContent = `${countC.toLocaleString('id-ID')} Produk Long-Tail`;
            if (cardCShare) cardCShare.textContent = `${sortedProds.length > 0 ? ((countC / sortedProds.length) * 100).toFixed(1) : 0}% dari Total Katalog`;
            if (cardCPct) {
                if (activeParetoMetric === 'Quantity') cardCPct.textContent = '~5% Volume Gudang';
                else if (activeParetoMetric === 'Orders') cardCPct.textContent = '~5% Checkout Pembeli';
                else cardCPct.textContent = '~5% Omzet';
