        // YoY Tooltip for 2023 vs 2024 vs 2025 vs 2026 Comparison
        function renderYoYTooltip({ series, seriesIndex, dataPointIndex, w }) {
            const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
