                            ${s.name.length > 28 ? s.name.slice(0,28)+'…' : s.name}
                            <span style="color:#6b7280"> + </span>
                            ${partner.name.length > 28 ? partner.name.slice(0,28)+'…' : partner.name}
                        </span>
                        <span style="font-size:0.72rem;color:#94a3b8">Buat paket bundling untuk naikkan AOV</span>
                    </div>`;
                }).filter(Boolean).join('') || '<div class="text-muted small">Cukup 1 paket combo yang direkomendasikan.</div>';

                // Add extra stable SKUs
                p3.innerHTML += bundleCandidates.slice(1).map(s => {
                    return `<div class="pilar-sku-item">
                        <span class="pilar-sku-name" title="${s.name}">${s.name}</span>
                        <span class="pilar-sku-badge badge-bundle">Komplemen</span>
                    </div>`;
                }).join('');
            }

            // Launch Window Advisor: based on peak day from curr.days
            const days = curr.days || [];
            let peakDay = null, peakRev = 0;
            days.forEach(d => {
                if ((d.rev || 0) > peakRev) { peakRev = d.rev; peakDay = d; }
            });

            const dayAdvice = {
                'Senin':   'Rilis voucher Senin pagi — momentum awal minggu untuk pekerja yang baru gajian.',
                'Selasa':  'Rilis Selasa siang — warm-up mid-week sebelum belanja ramai.',
                'Rabu':    'Rilis Rabu sore — jangkau segmen yang berbelanja menjelang akhir pekan.',
                'Kamis':   'Rilis Kamis sore — tangkap lonjakan Jumat–Minggu dengan early-bird promo.',
                'Jumat':   'Rilis Jumat pagi — puncak belanja, langsung aktifkan Flash Sale & Push Ads.',
                'Sabtu':   'Rilis Sabtu pagi — hari belanja utama, maksimalkan Live Streaming.',
                'Minggu':  'Rilis Minggu sore — tutup weekend dengan voucher last-chance sebelum pekan baru.',
            };

            if (peakDay) {
                const advice = dayAdvice[peakDay.day_name] || `Puncak penjualan di hari ${peakDay.day_name}.`;
                lwBody.innerHTML = `<strong>Hari puncak minggu ini: ${peakDay.day_name}</strong> (${fmtRp(peakDay.rev)}) — ${advice}
                    <br><span style="color:#94a3b8;font-size:0.75rem">Format A (Flash Sprint 3 Hari): mulai D-1 dari ${peakDay.day_name}. &nbsp;|&nbsp; Format B (Kampanye 7 Hari): mulai Senin dengan intensifikasi di ${peakDay.day_name}.</span>`;
            } else {
