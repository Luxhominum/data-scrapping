        function syncTopProductLabels() {
            if (!productsChart || !productsChart.w || !productsChart.w.globals) return;
            const fullNames = productsChart.w.globals.fullNames || [];
            if (!fullNames.length) return;

            const textEls = document.querySelectorAll('#topProductsChart .apexcharts-yaxis-texts-g text, #topProductsChart .apexcharts-yaxis-label');
            textEls.forEach((textEl, idx) => {
                const fullTitle = fullNames[idx];
                if (!fullTitle) return;

                textEl.setAttribute('title', fullTitle);
                textEl.setAttribute('data-full-title', fullTitle);
                textEl.style.cursor = 'pointer';

                let titleNode = textEl.querySelector('title');
                if (!titleNode) {
                    titleNode = document.createElementNS('http://www.w3.org/2000/svg', 'title');
                    textEl.appendChild(titleNode);
                }
                titleNode.textContent = fullTitle;

                if (!textEl.dataset.hoverSynced) {
                    textEl.dataset.hoverSynced = 'true';
                    textEl.addEventListener('mouseenter', () => {
                        const bars = document.querySelectorAll('#topProductsChart .apexcharts-bar-area');
                        const bar = bars[idx];
                        if (bar) {
                            const rect = bar.getBoundingClientRect();
                            const evt = new MouseEvent('mousemove', {
                                bubbles: true,
                                clientX: rect.left + Math.min(rect.width / 2, 50),
                                clientY: rect.top + rect.height / 2
                            });
                            bar.dispatchEvent(evt);
                        }
                    });
                    textEl.addEventListener('mouseleave', () => {
                        const bars = document.querySelectorAll('#topProductsChart .apexcharts-bar-area');
                        const bar = bars[idx];
                        if (bar) {
                            bar.dispatchEvent(new MouseEvent('mouseleave', { bubbles: true }));
                        }
                    });
                }
            });
        }

