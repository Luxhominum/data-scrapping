        // Render Product Lifecycle Cards with Peak Spike & Tooltips
        function renderProductLifecycles(filtered) {
            // Synchronize months strictly with the currently active filtered dataset!
            let allMonths = [...new Set(filtered.map(d => d.Month))].sort();
            if (allMonths.length === 0) {
                allMonths = [...new Set(tableData.map(d => d.Month))].sort();
            }

            const productMonthMap = {};
            filtered.forEach(d => {
                const name = d.Product_Name;
                if (!productMonthMap[name]) {
                    productMonthMap[name] = {
                        name: name,
                        category: d.Category,
                        totalRevenue: 0,
                        totalQty: 0,
                        totalOrders: 0,
                        months: {}
                    };
                }
                productMonthMap[name].totalRevenue += (d.Revenue || 0);
                productMonthMap[name].totalQty += (d.Quantity || 0);
                productMonthMap[name].totalOrders += (d.Orders || 0);

                if (!productMonthMap[name].months[d.Month]) {
                    productMonthMap[name].months[d.Month] = { rev: 0, qty: 0, ord: 0 };
                }
                productMonthMap[name].months[d.Month].rev += (d.Revenue || 0);
                productMonthMap[name].months[d.Month].qty += (d.Quantity || 0);
                productMonthMap[name].months[d.Month].ord += (d.Orders || 0);
            });

            // Rank and Filter Products based on active metric & search query
            const allSortedProducts = Object.values(productMonthMap)
                .sort((a, b) => {
                    if (activeLifecycleMetric === 'Quantity') return b.totalQty - a.totalQty;
                    if (activeLifecycleMetric === 'Orders') return b.totalOrders - a.totalOrders;
                    return b.totalRevenue - a.totalRevenue;
                });

            let topProducts = [];
            const query = (lifecycleSearchQuery || '').trim().toLowerCase();
            if (query !== '') {
                // Free search across ALL products in store (show up to 10 matching)
                topProducts = allSortedProducts.filter(p => p.name.toLowerCase().includes(query)).slice(0, 10);
            } else {
                // Strictly TOP 5 Products by default
                topProducts = allSortedProducts.slice(0, 5);
            }

            const numMonths = allMonths.length;
            const midIndex = Math.max(1, Math.floor(numMonths / 2));
            const firstHalfMonths = allMonths.slice(0, midIndex);
            const secondHalfMonths = allMonths.slice(midIndex);

            const h1Title = firstHalfMonths.length > 0 
                ? (firstHalfMonths.length === 1 ? formatMonthLabel(firstHalfMonths[0]) : `${formatMonthLabel(firstHalfMonths[0])}–${formatMonthLabel(firstHalfMonths[firstHalfMonths.length - 1])}`)
                : 'H1';
            const h2Title = secondHalfMonths.length > 0
                ? (secondHalfMonths.length === 1 ? formatMonthLabel(secondHalfMonths[0]) : `${formatMonthLabel(secondHalfMonths[0])}–${formatMonthLabel(secondHalfMonths[secondHalfMonths.length - 1])}`)
                : 'H2';

            function getVal(p, m) {
                const entry = p.months[m];
                if (!entry) return 0;
                if (activeLifecycleMetric === 'Quantity') return entry.qty || 0;
                if (activeLifecycleMetric === 'Orders') return entry.ord || 0;
                return entry.rev || 0;
            }

            function formatVal(v) {
                if (activeLifecycleMetric === 'Quantity') return v.toLocaleString('id-ID') + ' pcs';
                if (activeLifecycleMetric === 'Orders') return v.toLocaleString('id-ID') + ' pesanan';
                return formatIDR(v);
            }

            function formatValCompact(v) {
                if (activeLifecycleMetric === 'Quantity') return v.toLocaleString('id-ID') + ' pcs';
                if (activeLifecycleMetric === 'Orders') return v.toLocaleString('id-ID') + ' order';
                return formatIDRCompact(v);
            }

            const classified = topProducts.map(p => {
                const h1Val = firstHalfMonths.reduce((acc, m) => acc + getVal(p, m), 0);
                const h2Val = secondHalfMonths.reduce((acc, m) => acc + getVal(p, m), 0);
                
                let tag = 'Stabil (Steady)';
                let tagClass = 'lc-steady';

                if (h1Val === 0 && h2Val > 0) {
                    tag = 'Baru (New)';
                    tagClass = 'lc-new';
                } else if (h2Val > h1Val * 1.35) {
                    tag = 'Meningkat (Rising)';
                    tagClass = 'lc-rising';
                } else if (h1Val > h2Val * 1.35) {
                    tag = 'Menurun (Declining)';
                    tagClass = 'lc-declining';
                }

                // Find Peak Month Spike within filtered months
                let peakMonth = '';
                let peakVal = 0;
                allMonths.forEach(m => {
                    const v = getVal(p, m);
                    if (v > peakVal) {
                        peakVal = v;
                        peakMonth = m;
                    }
                });

                // Generate SVG sparkline points strictly mapped to allMonths
                const vals = allMonths.map(m => getVal(p, m));
                const maxVal = Math.max(...vals, 1);
                const sliceW = numMonths > 0 ? 260 / numMonths : 260;

                const points = vals.map((v, i) => {
                    const x = numMonths > 1 ? (i / (numMonths - 1)) * 260 : 130;
                    const y = 34 - (v / maxVal) * 26;
                    return `${x.toFixed(1)},${y.toFixed(1)}`;
                }).join(' ');

                const slicesAndDots = vals.map((v, i) => {
                    const m = allMonths[i];
                    const x = numMonths > 1 ? (i / (numMonths - 1)) * 260 : 130;
                    const y = 34 - (v / maxVal) * 26;
                    const mLabel = formatMonthLabel(m);
                    const valFmt = formatVal(v);
                    const sliceX = Math.max(0, x - sliceW / 2);

                    return `
                        <rect class="sparkline-slice" x="${sliceX.toFixed(1)}" y="0" width="${sliceW.toFixed(1)}" height="42"
                              onmouseenter="showSparklineTooltip(event, '${mLabel}', '${m}', '${valFmt}')"
                              onmousemove="moveSparklineTooltip(event)"
                              onmouseleave="hideSparklineTooltip()">
                            <title>${m} (${mLabel}): ${valFmt}</title>
                        </rect>
                        <circle class="sparkline-dot" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${v > 0 ? '2.5' : '1.5'}"
                                onmouseenter="showSparklineTooltip(event, '${mLabel}', '${m}', '${valFmt}')"
                                onmousemove="moveSparklineTooltip(event)"
                                onmouseleave="hideSparklineTooltip()">
                            <title>${m} (${mLabel}): ${valFmt}</title>
                        </circle>
                    `;
                }).join('');

                const activeMonthsCount = allMonths.filter(m => getVal(p, m) > 0).length;
                const totalDisplay = activeLifecycleMetric === 'Quantity'
                    ? p.totalQty.toLocaleString('id-ID') + ' pcs'
                    : (activeLifecycleMetric === 'Orders'
                        ? p.totalOrders.toLocaleString('id-ID') + ' pesanan'
                        : formatIDR(p.totalRevenue));

                return { ...p, tag, tagClass, h1Val, h2Val, points, slicesAndDots, peakMonth, peakVal, activeMonthsCount, totalDisplay };
            });

            const chipAll = document.getElementById('chipAllLifecycles');
            if (chipAll) {
                if (query !== '') {
                    chipAll.textContent = `Hasil Pencarian (${classified.length})`;
                } else {
                    chipAll.textContent = `Top 5 Produk (${classified.length})`;
