            const aov = totalOrd > 0 ? Math.round(totalRev / totalOrd) : 0;

            // Monthly aggregation across all 44 months
            const allMonths = [...new Set(compData.map(d => d.Month))].sort();
            const monthlyMap = {};
            allMonths.forEach(m => {
                monthlyMap[m] = { rev: 0, qty: 0, ord: 0 };
            });
            pItems.forEach(d => {
                if (monthlyMap[d.Month]) {
                    monthlyMap[d.Month].rev += (d.Revenue || 0);
