        // Populate Month Dropdown dynamically based on selected Year
        function populateMonthDropdown(selectedYear) {
            const monthSelect = document.getElementById('monthFilter');
            if (!monthSelect) return;
            const currentSelectedMonth = monthSelect.value;
            
            monthSelect.innerHTML = '';

            if (selectedYear === 'ALL') {
                // Disabled state: all 4 years full timeline
                monthSelect.disabled = true;
                monthSelect.style.opacity = '0.65';
                monthSelect.style.cursor = 'not-allowed';
                monthSelect.title = 'Pilih Tahun terlebih dahulu untuk memfilter bulan';
                const opt = document.createElement('option');
                opt.value = 'ALL';
                opt.textContent = 'Semua Bulan (4 Tahun)';
                monthSelect.appendChild(opt);
                monthSelect.value = 'ALL';
            } else {
                // Enabled state: exactly 12 clean months for selected year (up to latest available month for 2026)
                monthSelect.disabled = false;
                monthSelect.style.opacity = '1';
                monthSelect.style.cursor = 'pointer';
                monthSelect.title = `Pilih bulan untuk tahun ${selectedYear}`;
                
                const optAll = document.createElement('option');
                optAll.value = 'ALL';
                optAll.textContent = `Semua Bulan (${selectedYear})`;
                monthSelect.appendChild(optAll);

                // Check valid months in tableData for this year
                const yearMonths = [...new Set(tableData.filter(d => String(d.Year) === selectedYear).map(d => d.Month))].sort();

                MONTH_NAMES_MAP.forEach(mObj => {
                    const fullMonthKey = `${selectedYear}-${mObj.num}`;
                    // Only display months that exist in the database (e.g. up to 2026-08 for 2026)
                    if (yearMonths.includes(fullMonthKey)) {
                        const opt = document.createElement('option');
                        opt.value = fullMonthKey;
                        opt.textContent = `${mObj.name} ${selectedYear}`;
                        if (fullMonthKey === currentSelectedMonth) {
                            opt.selected = true;
                        }
                        monthSelect.appendChild(opt);
                    }
                });

                // If previous selection is no longer valid, reset to ALL
                if (currentSelectedMonth !== 'ALL' && !yearMonths.includes(currentSelectedMonth)) {
                    monthSelect.value = 'ALL';
                }
            }
        }

