                const y1Title = activeParetoMetric === 'Quantity' ? 'Unit Terjual (Pcs)' : (activeParetoMetric === 'Orders' ? 'Jumlah Pesanan (Orders)' : 'Pendapatan Produk (IDR)');
                const y2Title = activeParetoMetric === 'Quantity' ? 'Kumulatif Unit (%)' : (activeParetoMetric === 'Orders' ? 'Kumulatif Pesanan (%)' : 'Kumulatif Omzet (%)');
