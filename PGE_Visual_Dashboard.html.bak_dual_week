                if (row.rev > peakRev) {
                    peakRev = row.rev;
                    peakMonth = m;
                    peakQty = row.qty;
                    peakOrd = row.ord;
                }
            });

            // Semester H1 vs H2 calculation
            const halfIdx = Math.floor(allMonths.length / 2);
            const h1Months = allMonths.slice(0, halfIdx);
            const h2Months = allMonths.slice(halfIdx);
            const h1Rev = h1Months.reduce((acc, m) => acc + monthlyMap[m].rev, 0);
            const h2Rev = h2Months.reduce((acc, m) => acc + monthlyMap[m].rev, 0);
            const h1Qty = h1Months.reduce((acc, m) => acc + monthlyMap[m].qty, 0);
            const h2Qty = h2Months.reduce((acc, m) => acc + monthlyMap[m].qty, 0);

            let statusTag = 'Stabil (Steady)';
            let statusClass = 'lc-steady';
            let statusIcon = 'bi-dash-circle-fill';
            let statusDesc = 'Penjualan konsisten antara paruh awal dan paruh akhir.';
            let actionAdvisory = 'Pertahankan level stok buffer reguler (Lead Time 7–14 hari). Produk penopang omzet stabil.';

            if (h1Rev === 0 && h2Rev > 0) {
                statusTag = 'Baru (New)';
                statusClass = 'lc-new';
                statusIcon = 'bi-stars';
                statusDesc = 'Produk baru mulai terdeteksi penjualan di paruh akhir periode.';
                actionAdvisory = 'Uji coba penerimaan pasar dengan batch produksi kecil (100–300 pcs) sebelum komitmen bahan baku masif.';
            } else if (h2Rev > h1Rev * 1.35) {
                statusTag = 'Meningkat (Rising)';
                statusClass = 'lc-rising';
                statusIcon = 'bi-arrow-up-right-circle-fill';
                const growthPct = h1Rev > 0 ? (((h2Rev - h1Rev) / h1Rev) * 100).toFixed(1) : '100+';
                statusDesc = `Lonjakan pertumbuhan omzet +${growthPct}% pada H2 didorong permintaan pasar yang ekspansif.`;
                actionAdvisory = 'Segera amankan slot jam penjahit dan alokasikan Safety Stock H-30 untuk mengantisipasi lonjakan permintaan lanjutan.';
            } else if (h1Rev > h2Rev * 1.35) {
                statusTag = 'Menurun (Declining)';
                statusClass = 'lc-declining';
                statusIcon = 'bi-arrow-down-right-circle-fill';
                const dropPct = (((h1Rev - h2Rev) / h1Rev) * 100).toFixed(1);
                statusDesc = `Terjadi penurunan omzet sebesar -${dropPct}% pada H2 setelah mencapai puncaknya di ${formatMonthLabel(peakMonth)}.`;
                actionAdvisory = 'Kendalikan pasokan bahan mentah agar tidak mengendap di gudang. Terapkan bundling etalase atau diskon flash sale untuk memutar inventori.';
            }

            // Platform split (Shopee vs TikTok)
            const shopeeItems = pItems.filter(d => d.Platform === 'Shopee');
            const tiktokItems = pItems.filter(d => d.Platform === 'TikTok');
            const shopeeRev = shopeeItems.reduce((a, b) => a + (b.Revenue || 0), 0);
            const tiktokRev = tiktokItems.reduce((a, b) => a + (b.Revenue || 0), 0);
            const shopeeQty = shopeeItems.reduce((a, b) => a + (b.Quantity || 0), 0);
            const tiktokQty = tiktokItems.reduce((a, b) => a + (b.Quantity || 0), 0);
            const shopeeOrd = shopeeItems.reduce((a, b) => a + (b.Orders || 0), 0);
            const tiktokOrd = tiktokItems.reduce((a, b) => a + (b.Orders || 0), 0);
            const shopeePct = totalRev > 0 ? ((shopeeRev / totalRev) * 100).toFixed(1) : '0.0';
            const tiktokPct = totalRev > 0 ? ((tiktokRev / totalRev) * 100).toFixed(1) : '0.0';
            const shopeeAov = shopeeOrd > 0 ? Math.round(shopeeRev / shopeeOrd) : 0;
            const tiktokAov = tiktokOrd > 0 ? Math.round(tiktokRev / tiktokOrd) : 0;

            // Variation SKU breakdown
            const varMap = {};
            pItems.forEach(d => {
