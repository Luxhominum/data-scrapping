                seriesName = 'Unit Terjual';
                xFormatter = val => val >= 1000 ? (val / 1000).toFixed(val % 1000 === 0 ? 0 : 1) + 'k pcs' : Math.round(val) + ' pcs';
            } else if (activeTopProductsMetric === 'Orders') {
