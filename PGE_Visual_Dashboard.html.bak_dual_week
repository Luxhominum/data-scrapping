                        const items = filtered.filter(d => d.Month === mStr);
                        if (currentCategoryMetric === 'Quantity') {
                            return items.reduce((acc, cur) => acc + (cur.Quantity || 0), 0);
                        } else if (currentCategoryMetric === 'Orders') {
