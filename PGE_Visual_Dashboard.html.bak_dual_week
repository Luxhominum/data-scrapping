            // Render Filtered Pareto Table
            renderFilteredParetoTable();

            // Render Pareto Chart (Top 12 Bar Revenue + Cumulative Line)
            const topChartProds = classified.slice(0, 12);
            const paretoEl = document.querySelector('#paretoLorenzChart');
            if (paretoEl) {
