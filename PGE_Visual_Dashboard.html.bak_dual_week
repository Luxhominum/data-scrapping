            const elDonutShopeeShare = document.getElementById('donutCardShopeeShare');
            const elDonutShopeeOrders = document.getElementById('donutCardShopeeOrders');
            const elDonutShopeeAov = document.getElementById('donutCardShopeeAov');

            const elDonutTikTokRev = document.getElementById('donutCardTikTokRev');
            const elDonutTikTokShare = document.getElementById('donutCardTikTokShare');
            const elDonutTikTokOrders = document.getElementById('donutCardTikTokOrders');
            const elDonutTikTokAov = document.getElementById('donutCardTikTokAov');

            if (elDonutShopeeRev) elDonutShopeeRev.textContent = formatIDRCompact(shopeeRev);
            if (elDonutShopeeShare) elDonutShopeeShare.textContent = `${shopeePct}%`;
            if (elDonutShopeeOrders) elDonutShopeeOrders.textContent = `${shopeeOrders.toLocaleString('id-ID')} ord`;
            if (elDonutShopeeAov) elDonutShopeeAov.textContent = `AOV: ${formatIDRCompact(shopeeAov)}`;

            if (elDonutTikTokRev) elDonutTikTokRev.textContent = formatIDRCompact(tiktokRev);
