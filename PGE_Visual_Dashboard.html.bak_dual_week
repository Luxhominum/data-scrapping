        // Top 10 Products Chart Data (Multi-Metric: Revenue, Quantity, Orders)
        function getTopProductsData(filtered) {
            const productMap = {};
            filtered.forEach(d => {
                const name = d.Product_Name || 'Unknown';
                if (!productMap[name]) productMap[name] = { revenue: 0, quantity: 0, orders: 0, category: d.Category };
                productMap[name].revenue += (d.Revenue || 0);
                productMap[name].quantity += (d.Quantity || 0);
                productMap[name].orders += (d.Orders || 0);
            });

            const sorted = Object.entries(productMap)
                .sort((a, b) => {
                    if (activeTopProductsMetric === 'Quantity') return b[1].quantity - a[1].quantity;
                    if (activeTopProductsMetric === 'Orders') return b[1].orders - a[1].orders;
                    return b[1].revenue - a[1].revenue;
                })
                .slice(0, 10);

            return {
                shortNames: sorted.map(item => cleanShortTitle(item[0])),
                fullNames: sorted.map(item => item[0]),
                categories: sorted.map(item => item[1].category),
                values: sorted.map(item => {
                    if (activeTopProductsMetric === 'Quantity') return item[1].quantity;
                    if (activeTopProductsMetric === 'Orders') return item[1].orders;
                    return item[1].revenue;
                })
            };
        }

        function renderTopProductsChart() {
            if (!productsChart) return;
            const filtered = getFilteredData();
