        // Calculate and Render KPIs
        function updateKPIs(filtered) {
            const totalRev = filtered.reduce((acc, cur) => acc + (cur.Revenue || 0), 0);
            const totalOrders = filtered.reduce((acc, cur) => acc + (cur.Orders || 0), 0);
            const totalQty = filtered.reduce((acc, cur) => acc + (cur.Quantity || 0), 0);
            const aov = totalOrders > 0 ? (totalRev / totalOrders) : 0;

            const shopeeRev = filtered.filter(d => d.Platform === 'Shopee').reduce((acc, cur) => acc + (cur.Revenue || 0), 0);
            const tiktokRev = filtered.filter(d => d.Platform === 'TikTok').reduce((acc, cur) => acc + (cur.Revenue || 0), 0);
            const shopeeOrders = filtered.filter(d => d.Platform === 'Shopee').reduce((acc, cur) => acc + (cur.Orders || 0), 0);
            const tiktokOrders = filtered.filter(d => d.Platform === 'TikTok').reduce((acc, cur) => acc + (cur.Orders || 0), 0);
            const shopeeAov = shopeeOrders > 0 ? (shopeeRev / shopeeOrders) : 0;
            const tiktokAov = tiktokOrders > 0 ? (tiktokRev / tiktokOrders) : 0;

            const shopeePct = totalRev > 0 ? ((shopeeRev / totalRev) * 100).toFixed(1) : 0;
            const tiktokPct = totalRev > 0 ? ((tiktokRev / totalRev) * 100).toFixed(1) : 0;

            document.getElementById('kpiRevenue').textContent = formatIDR(totalRev);
            document.getElementById('kpiOrders').textContent = totalOrders.toLocaleString('id-ID');
            document.getElementById('kpiQuantity').textContent = totalQty.toLocaleString('id-ID');
            document.getElementById('kpiAOV').textContent = formatIDR(aov);

            document.getElementById('kpiShopeeRev').textContent = `Shopee: ${shopeePct}% (${formatIDRCompact(shopeeRev)})`;
            document.getElementById('kpiTikTokRev').textContent = `TikTok: ${tiktokPct}% (${formatIDRCompact(tiktokRev)})`;

            document.getElementById('splitBarShopee').style.width = `${shopeePct}%`;
            document.getElementById('splitBarTikTok').style.width = `${tiktokPct}%`;

            document.getElementById('filterMatchCount').textContent = `${filtered.length.toLocaleString('id-ID')} Baris Transaksi Aktif`;

            document.getElementById('statShopeeRatio').textContent = `${shopeePct}% (${formatIDRCompact(shopeeRev)})`;
            document.getElementById('statTikTokRatio').textContent = `${tiktokPct}% (${formatIDRCompact(tiktokRev)})`;
            document.getElementById('statAovSummary').textContent = formatIDR(aov);

            // Update Insights Section Platform Split Bar
            const insightBarShopee = document.getElementById('statInsightBarShopee');
            const insightBarTikTok = document.getElementById('statInsightBarTikTok');
            if (insightBarShopee) insightBarShopee.style.width = `${shopeePct}%`;
            if (insightBarTikTok) insightBarTikTok.style.width = `${tiktokPct}%`;

            // Dynamic Peak Month calculation from filtered
            const elPeakMonth = document.getElementById('statPeakMonth');
            if (elPeakMonth) {
                if (!filtered || filtered.length === 0) {
                    elPeakMonth.textContent = '-';
                } else {
                    const monthRevMap = {};
                    filtered.forEach(d => {
                        if (d.Month) {
                            monthRevMap[d.Month] = (monthRevMap[d.Month] || 0) + (d.Revenue || 0);
                        }
                    });
                    const sortedMonthPairs = Object.entries(monthRevMap).sort((a, b) => b[1] - a[1]);
                    if (sortedMonthPairs.length > 0) {
                        const [topMonthStr, topMonthRev] = sortedMonthPairs[0];
                        const monthNamesIndo = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
                        const [y, m] = topMonthStr.split('-');
                        const mIdx = parseInt(m, 10) - 1;
                        const formattedMonthName = (monthNamesIndo[mIdx] || m) + ' ' + y;
                        elPeakMonth.textContent = `${formattedMonthName} (${formatIDRCompact(topMonthRev)})`;
                    } else {
                        elPeakMonth.textContent = '-';
                    }
                }
            }

            // Dynamic Active Categories Count
            const elActiveCats = document.getElementById('statActiveCategories');
            if (elActiveCats) {
                if (!filtered || filtered.length === 0) {
                    elActiveCats.textContent = '0 Lini Aktif';
                } else {
                    const activeCatsSet = new Set(filtered.map(d => d.Category || classifyProduct(d.Product_Name, d.Variation)));
                    const count = activeCatsSet.size;
