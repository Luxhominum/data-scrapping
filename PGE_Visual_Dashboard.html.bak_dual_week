                monthMap[m].revenue += (d.Revenue || 0);
                monthMap[m].orders += (d.Orders || 0);
                monthMap[m].quantity += (d.Quantity || 0);
            });

            const sortedMonths = Object.keys(monthMap).sort();
            const formattedCategories = sortedMonths.map(m => formatMonthLabel(m));
            const revenueSeries = sortedMonths.map(m => monthMap[m].revenue);
            const ordersSeries = sortedMonths.map(m => monthMap[m].orders);
            const quantitySeries = sortedMonths.map(m => monthMap[m].quantity);

            return { categories: formattedCategories, rawMonths: sortedMonths, revenue: revenueSeries, orders: ordersSeries, quantity: quantitySeries };
