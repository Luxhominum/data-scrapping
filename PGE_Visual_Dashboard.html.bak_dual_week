            const L_mult = currentLeadTimeDays / 30.0;

            const rows = CATEGORIES_LIST.map(cat => {
                const stats = categoryForecastingStats[cat] || { avgQty: 0, stdQty: 0, avgRev: 0, stdRev: 0 };
                const avg = isQty ? stats.avgQty : stats.avgRev;
                const std = isQty ? stats.stdQty : stats.stdRev;

                const ss = Math.round(1.65 * std * L_ratio);
                const rop = Math.round((avg * L_mult) + ss);

                return {
                    category: cat,
                    avg: avg,
                    ss: ss,
                    rop: rop
                };
            }).sort((a, b) => b.avg - a.avg);

            tbody.innerHTML = rows.map(r => `
