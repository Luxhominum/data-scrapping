        function initForecastingEngine() {
            // 1. Pre-aggregate historical data by Month (44 months) and by Category
            const monthMapOverall = {};
            const catMonthMap = {};

            tableData.forEach(d => {
                const m = d.Month;
                if (!m || m.length < 7) return;
                const cat = d.Category || 'Others';
                const qty = Number(d.Quantity) || 0;
                const rev = Number(d.Revenue) || 0;

                if (!monthMapOverall[m]) {
                    monthMapOverall[m] = { qty: 0, rev: 0, orders: 0 };
                }
                monthMapOverall[m].qty += qty;
                monthMapOverall[m].rev += rev;
                monthMapOverall[m].orders += (Number(d.Orders) || 1);

                if (!catMonthMap[cat]) catMonthMap[cat] = {};
                if (!catMonthMap[cat][m]) catMonthMap[cat][m] = { qty: 0, rev: 0 };
                catMonthMap[cat][m].qty += qty;
                catMonthMap[cat][m].rev += rev;
            });

            const allMonths = Object.keys(monthMapOverall).sort();
            forecastHistoricalSeries = { months: allMonths, data: monthMapOverall };
            forecastCatSeries = catMonthMap;

            // 2. Compute 12-Month Seasonal Multipliers using complete years 2023, 2024, 2025
            const monthlySeasonalFactors = {
                Quantity: [0, 1.38, 0.69, 1.35, 1.06, 0.89, 0.95, 0.89, 0.85, 0.66, 0.97, 1.23, 1.07],
                Revenue:  [0, 1.17, 0.72, 1.16, 0.97, 1.01, 0.95, 0.90, 1.04, 0.80, 0.94, 1.29, 1.05]
            };
            seasonalIndices = monthlySeasonalFactors;

            // 3. Compute Category Baseline Stats (Last 12 Months: 2025-09 to 2026-08)
            const recent12 = allMonths.slice(-12);
            categoryForecastingStats = {};

            CATEGORIES_LIST.forEach(cat => {
                const mData = catMonthMap[cat] || {};
                const recentQtys = recent12.map(m => (mData[m] ? mData[m].qty : 0));
                const recentRevs = recent12.map(m => (mData[m] ? mData[m].rev : 0));

                const avgQty = recentQtys.reduce((a, b) => a + b, 0) / 12.0;
                const avgRev = recentRevs.reduce((a, b) => a + b, 0) / 12.0;

                const varQty = recentQtys.reduce((sum, val) => sum + Math.pow(val - avgQty, 2), 0) / 11.0;
                const stdQty = Math.sqrt(varQty);

                const varRev = recentRevs.reduce((sum, val) => sum + Math.pow(val - avgRev, 2), 0) / 11.0;
                const stdRev = Math.sqrt(varRev);

                categoryForecastingStats[cat] = {
                    avgQty: avgQty,
                    stdQty: stdQty,
                    avgRev: avgRev,
                    stdRev: stdRev
                };
            });

            console.log("Forecasting engine initialized with 44 months of data and 16 categories.");
        }

