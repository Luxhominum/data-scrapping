                const activeSlots = rawSlots.filter(s => s.month && s.month !== 'none');
                if (activeSlots.length === 0) {
                    activeSlots.push(rawSlots[0]);
                }

                const slotMetrics = activeSlots.map(s => {
                    const items = compData.filter(d => d.Month === s.month);
                    const rev = items.reduce((a, b) => a + (b.Revenue || 0), 0);
