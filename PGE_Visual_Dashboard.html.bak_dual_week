                    } else if (currentCategoryMetric === 'Orders') {
                        return items.reduce((acc, cur) => acc + (cur.Orders || 0), 0);
                    } else {
                        return items.reduce((acc, cur) => acc + (cur.Revenue || 0), 0);
                    }
                });
                return {
                    name: cat,
                    data: data,
                    color: CATEGORY_COLORS[cat]
                };
            });

            return {
                categories: allMonths.map(m => formatMonthLabel(m)),
                rawMonths: allMonths,
                series: seriesList
            };
