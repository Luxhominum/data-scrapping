                const series2Name = activeParetoMetric === 'Quantity' ? 'Persentase Kumulatif Unit (%)' : (activeParetoMetric === 'Orders' ? 'Persentase Kumulatif Pesanan (%)' : 'Persentase Kumulatif Omzet (%)');

                const paretoOpts = {
                    chart: {
