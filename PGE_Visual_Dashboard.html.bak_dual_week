                    diffPct,
                    `"${badge.label}"`
                ].join(','));
            });
            const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href = url;
            a.download = `campaign_plan_${selectedWeekKey || 'week'}.csv`;
            a.click();
            URL.revokeObjectURL(url);
        }

        // Master render for campaign planner
        function renderCampaignPlanner() {
            renderCampaignPlaybook();
            if (currentCampaignView === 'sidebyside') {
                renderSideBySideTable();
            }
        }

        // ═══════════════════════════════════════════════
        // END CAMPAIGN PLANNER ENGINE
