        // ── helpers ──────────────────────────────────
        function fmtRp(n) {
            if (!n && n !== 0) return 'Rp —';
            return 'Rp ' + Math.round(n).toLocaleString('id-ID');
        }
        function fmtPct(n) {
            if (!n && n !== 0) return '—';
            const sign = n > 0 ? '+' : '';
            return sign + n.toFixed(1) + '%';
        }

        function getCampaignPlatformKey() {
            // returns 'rev' | 'shopee_rev' | 'tiktok_rev' based on selectedWeeklyPlatform
            if (typeof selectedWeeklyPlatform === 'undefined') return 'rev';
            if (selectedWeeklyPlatform === 'Shopee') return 'shopee';
            if (selectedWeeklyPlatform === 'TikTok') return 'tiktok';
            return 'all';
        }

        function getCampaignWeekPair() {
            // Returns { curr: weekObj, prev: weekObj|null }
            const catalog = WEEKLY_DATA.weeks_catalog;
            const currIdx = catalog.findIndex(w => w.key === selectedWeekKey);
            if (currIdx < 0) return { curr: null, prev: null };
            const curr = catalog[currIdx];
            const prev = currIdx > 0 ? catalog[currIdx - 1] : null;
            return { curr, prev };
        }

        function getSkuRevForPlatform(skuObj, platform) {
            // surging_skus / declining_skus carry curr_rev, prev_rev from all platforms
            // We do a simple platform-agnostic return since SKU breakdown is all-platform
            return { curr: skuObj.curr_rev || 0, prev: skuObj.prev_rev || 0, diff: skuObj.diff_rev || 0 };
        }

        function buildSkuDeltaList() {
            // Merges surging + declining SKUs from curr week into a unified sorted list
            const { curr, prev } = getCampaignWeekPair();
            if (!curr) return [];

            const map = {};  // sku -> { name, curr_rev, prev_rev }

            // Add surging
            (curr.surging_skus || []).forEach(s => {
                map[s.sku] = {
                    sku: s.sku,
                    name: s.name,
                    curr_rev: s.curr_rev || 0,
                    prev_rev: s.prev_rev || 0,
                    diff_rev: s.diff_rev || 0,
                    diff_ord: s.diff_ord || 0,
                };
            });

            // Add declining
            (curr.declining_skus || []).forEach(s => {
                if (!map[s.sku]) {
                    map[s.sku] = {
                        sku: s.sku,
                        name: s.name,
                        curr_rev: s.curr_rev || 0,
                        prev_rev: s.prev_rev || 0,
                        diff_rev: s.diff_rev || 0,
                        diff_ord: s.diff_ord || 0,
                    };
                }
            });

            // Sort by absolute diff_rev descending
            return Object.values(map).sort((a, b) => Math.abs(b.diff_rev) - Math.abs(a.diff_rev));
        }

        function getCampaignBadge(skuObj) {
            const diffPct = skuObj.prev_rev > 0
                ? ((skuObj.curr_rev - skuObj.prev_rev) / skuObj.prev_rev * 100)
                : (skuObj.curr_rev > 0 ? 100 : 0);
            if (diffPct >= 10) return { label: '🚀 Push Ads', cls: 'badge-push' };
            if (diffPct <= -10) return { label: '⚡ Flash Sale', cls: 'badge-flash' };
            if (diffPct > -10 && diffPct < 10 && skuObj.curr_rev > 0) return { label: '📦 Bundling', cls: 'badge-bundling' };
            return { label: '✅ Normalisasi', cls: 'badge-normal' };
        }

