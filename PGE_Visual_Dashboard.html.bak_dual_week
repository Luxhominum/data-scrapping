            const p3 = document.getElementById('pilar3Body');
            const lwBody = document.getElementById('launchWindowBody');
            if (!p1 || !p2 || !p3) return;

            if (!curr) {
                [p1, p2, p3].forEach(el => el.innerHTML = '<div class="text-muted small">Pilih minggu di atas.</div>');
                return;
            }

            const surging   = curr.surging_skus  || [];
            const declining = curr.declining_skus || [];

            // Pilar 1: top surging (max 4)
            if (surging.length === 0) {
                p1.innerHTML = '<div class="text-muted small">Tidak ada SKU dengan momentum naik minggu ini.</div>';
            } else {
                p1.innerHTML = surging.slice(0, 4).map(s => {
                    const diffPct = s.prev_rev > 0 ? (s.diff_rev / s.prev_rev * 100).toFixed(1) : '∞';
                    return `<div class="pilar-sku-item">
                        <span class="pilar-sku-name" title="${s.name}">${s.name}</span>
                        <span class="pilar-sku-badge badge-up">+${diffPct}%</span>
                    </div>`;
                }).join('');
            }

            // Pilar 2: top declining (max 4)
            if (declining.length === 0) {
                p2.innerHTML = '<div class="text-muted small">Tidak ada SKU dengan penurunan signifikan minggu ini.</div>';
            } else {
                p2.innerHTML = declining.slice(0, 4).map(s => {
                    const diffPct = s.prev_rev > 0 ? (s.diff_rev / s.prev_rev * 100).toFixed(1) : '0';
                    return `<div class="pilar-sku-item">
                        <span class="pilar-sku-name" title="${s.name}">${s.name}</span>
                        <span class="pilar-sku-badge badge-down">${diffPct}%</span>
                    </div>`;
                }).join('');
            }

            // Pilar 3: bundling candidates (SKUs in both surging & declining of prev week — use stable/mid performers)
            // Strategy: pick SKUs from surging that can pair with declining
            const all = [...surging, ...declining];
            const bundleCandidates = all
                .filter((s, i, arr) => arr.findIndex(x => x.sku === s.sku) === i) // unique
                .sort((a, b) => (b.curr_rev || 0) - (a.curr_rev || 0))
                .slice(0, 3);

            if (bundleCandidates.length < 2) {
                p3.innerHTML = '<div class="text-muted small">Perlu minimal 2 SKU aktif untuk rekomendasi bundling.</div>';
            } else {
                p3.innerHTML = bundleCandidates.map((s, idx) => {
                    const partner = bundleCandidates[(idx + 1) % bundleCandidates.length];
                    if (idx > 0) return ''; // show 1 combo suggestion
                    return `<div class="pilar-sku-item flex-column align-items-start gap-1">
                        <span class="pilar-sku-badge badge-bundle" style="font-size:0.72rem">COMBO HEMAT</span>
