        function updateWhatIfSimulator() {
            const priceSlider = document.getElementById('simPriceSlider');
            const tiktokSlider = document.getElementById('simTiktokSlider');
            const shopeeSlider = document.getElementById('simShopeeSlider');

            const priceVal = priceSlider ? parseInt(priceSlider.value, 10) : 0;
            const tiktokVal = tiktokSlider ? parseInt(tiktokSlider.value, 10) : 0;
            const shopeeVal = shopeeSlider ? parseInt(shopeeSlider.value, 10) : 0;

            const priceBadge = document.getElementById('simPriceVal');
            const tiktokBadge = document.getElementById('simTiktokVal');
            const shopeeBadge = document.getElementById('simShopeeVal');

            if (priceBadge) priceBadge.textContent = (priceVal >= 0 ? '+' : '') + priceVal + '%';
            if (tiktokBadge) tiktokBadge.textContent = '+' + tiktokVal + '%';
            if (shopeeBadge) shopeeBadge.textContent = '+' + shopeeVal + '%';

            // Baseline annual volume: ~238,000 pcs and ~Rp 2.4 Billion
            const baseAnnualRev = 2420000000;
            const baseAnnualQty = 238000;

            // Shopee share ~65%, TikTok share ~35%
            const platformGrowthFactor = (0.65 * (shopeeVal / 100.0)) + (0.35 * (tiktokVal / 100.0));
            const priceFactor = priceVal / 100.0;

            // Elasticity: +10% price causes -3% quantity drop
            const elasticityImpact = priceVal * -0.3 / 100.0;
            const netQtyGrowth = platformGrowthFactor + elasticityImpact;
            const netRevGrowth = (1 + platformGrowthFactor) * (1 + priceFactor) - 1;

            const deltaRev = Math.round(baseAnnualRev * netRevGrowth);
            const deltaQty = Math.round(baseAnnualQty * netQtyGrowth);

            const revEl = document.getElementById('simRevImpact');
            const qtyEl = document.getElementById('simQtyImpact');
            const insightEl = document.getElementById('simInsightText');

            if (revEl) {
                revEl.textContent = (deltaRev >= 0 ? '+' : '') + formatIDR(deltaRev);
                revEl.className = 'fw-bold mono fs-6 mt-1 ' + (deltaRev >= 0 ? 'text-success' : 'text-danger');
            }
            if (qtyEl) {
                qtyEl.textContent = (deltaQty >= 0 ? '+' : '') + deltaQty.toLocaleString('id-ID') + ' pcs';
                qtyEl.className = 'fw-bold mono fs-6 mt-1 ' + (deltaQty >= 0 ? 'text-primary' : 'text-danger');
            }

            if (insightEl) {
                if (priceVal > 10 && tiktokVal > 20) {
                    insightEl.innerHTML = '💡 <strong>Rekomendasi Strategis:</strong> Kenaikan HPP diimbangi pertumbuhan TikTok agresif menghasilkan lonjakan omzet optimal. Tambah 2 line penjahitan cadangan di Q4.';
                } else if (priceVal < 0) {
                    insightEl.innerHTML = '💡 <strong>Rekomendasi Strategis:</strong> Penurunan harga memicu kenaikan volume pesanan unit (+pcs) namun mengikis marjin kotor per transaksi.';
                } else {
                    insightEl.innerHTML = '💡 <strong>Rekomendasi Strategis:</strong> Kapasitas mesin dan penjahit konveksi saat ini mampu mengakomodasi proyeksi skenario ini dengan jam kerja normal.';
                }
            }
        }

