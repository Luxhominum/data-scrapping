            const totalRev = pItems.reduce((a, b) => a + (b.Revenue || 0), 0);
            const totalQty = pItems.reduce((a, b) => a + (b.Quantity || 0), 0);
            const totalOrd = pItems.reduce((a, b) => a + (b.Orders || 0), 0);
