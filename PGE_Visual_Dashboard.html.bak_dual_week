        function getForecastProjectionData(cat, metric) {
            const allMonths = forecastHistoricalSeries.months;
            const recent12 = allMonths.slice(-12);
            const isQty = metric === 'Quantity';

            let baseAvg = 0;
            if (cat === 'ALL') {
                const vals = recent12.map(m => isQty ? forecastHistoricalSeries.data[m].qty : forecastHistoricalSeries.data[m].rev);
                baseAvg = vals.reduce((a, b) => a + b, 0) / 12.0;
            } else {
                const stats = categoryForecastingStats[cat];
                baseAvg = stats ? (isQty ? stats.avgQty : stats.avgRev) : 0;
            }

            const multipliers = seasonalIndices[metric];
            const projections = FORECAST_MONTHS_AHEAD.map(item => {
                const mult = multipliers[item.monthIdx] || 1.0;
                const expected = Math.round(baseAvg * mult);
                const upperBound = Math.round(expected * 1.18);
                const lowerBound = Math.round(expected * 0.85);
                return {
                    key: item.key,
                    label: item.label,
                    monthIdx: item.monthIdx,
                    expected: expected,
                    upper: upperBound,
                    lower: lowerBound
                };
            });

            return { baseAvg, projections };
        }

