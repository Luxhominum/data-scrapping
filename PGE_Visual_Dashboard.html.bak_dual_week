            const val2024 = (series[1] && series[1][dataPointIndex]) || 0;
            const val2025 = (series[2] && series[2][dataPointIndex]) || 0;
            const val2026 = (series[3] && series[3][dataPointIndex]) || 0;

            const formatVal = val => currentCategoryMetric === 'Revenue' ? formatIDR(val) : Math.round(val).toLocaleString('id-ID') + (currentCategoryMetric === 'Quantity' ? ' pcs' : ' orders');

            const diff24vs23 = val2023 > 0 ? (((val2024 - val2023) / val2023) * 100).toFixed(1) : '-';
            const diff25vs24 = val2024 > 0 ? (((val2025 - val2024) / val2024) * 100).toFixed(1) : '-';
            const diff26vs25 = val2025 > 0 ? (((val2026 - val2025) / val2025) * 100).toFixed(1) : '-';

            return `
                <div style="background: #ffffff; border: 1px solid #cbd5e1; box-shadow: 0 12px 28px rgba(0,0,0,0.15); border-radius: 8px; padding: 10px 14px; font-family: 'Plus Jakarta Sans', sans-serif; width: 300px;">
