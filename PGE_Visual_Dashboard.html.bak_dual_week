        // Render Filtered Pareto Table
        function renderFilteredParetoTable() {
            const tableBody = document.getElementById('paretoTableBody');
            const infoText = document.getElementById('paretoTableInfoText');
            if (!tableBody) return;

            let items = [...currentParetoClassified];

            // 1. Filter by Class (A, B, C)
            if (activeParetoClass !== 'ALL') {
                items = items.filter(p => p.abcClass === activeParetoClass);
            }

            // 2. Filter by Category
            if (activeParetoCategory !== 'ALL') {
                items = items.filter(p => p.category === activeParetoCategory);
            }

            // 3. Filter by Search Query
            if (paretoSearchQuery.trim() !== '') {
                const q = paretoSearchQuery.toLowerCase().trim();
                items = items.filter(p => p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q));
            }

            // 4. Top 10 per Category Mode
            if (paretoTop10PerCategoryMode) {
                const catGroups = {};
                items.forEach(p => {
                    if (!catGroups[p.category]) catGroups[p.category] = [];
                    if (catGroups[p.category].length < 10) {
                        catGroups[p.category].push(p);
                    }
                });
                items = Object.values(catGroups).flat();
            }

            // Display up to 50 items for snappy performance
            const displayItems = items.slice(0, 50);

            if (infoText) {
