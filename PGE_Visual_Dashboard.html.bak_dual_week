                (arr || []).forEach(s => {
                    if (!map[s.sku]) map[s.sku] = { sku: s.sku, name: s.name, curr_rev: 0, prev_rev: 0, diff_rev: 0 };
                    if (which === 'surging' || which === 'all') {
                        map[s.sku].curr_rev = s.curr_rev || 0;
                        map[s.sku].prev_rev = s.prev_rev || 0;
                        map[s.sku].diff_rev = s.diff_rev || 0;
                    }
                });
            };
            addSku(curr.surging_skus, 'all');
            addSku(curr.declining_skus, 'all');

            _campaignTableData = Object.values(map)
                .sort((a, b) => Math.abs(b.diff_rev) - Math.abs(a.diff_rev));

