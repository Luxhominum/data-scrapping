                        <div style="font-size: 12px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 6px;">
                            <span>📅 Periode Bulan:</span> <span class="mono" style="color: #4f46e5; font-size: 13px;">${monthLabel}</span>
