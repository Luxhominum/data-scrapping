                        <span style="color: #f59e0b; font-weight: 700;">● Tahun 2023:</span>
                        <span class="mono fw-bold text-dark">${formatVal(val2023)}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 11px;">
                        <span style="color: #3b82f6; font-weight: 700;">● Tahun 2024:</span>
                        <span class="mono fw-bold text-dark">${formatVal(val2024)} <span class="badge ${diff24vs23 >= 0 ? 'bg-success' : 'bg-danger'} mono" style="font-size: 8.5px;">${diff24vs23 >= 0 ? '+' : ''}${diff24vs23}%</span></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 11px;">
                        <span style="color: #10b981; font-weight: 700;">● Tahun 2025:</span>
                        <span class="mono fw-bold text-dark">${formatVal(val2025)} <span class="badge ${diff25vs24 >= 0 ? 'bg-success' : 'bg-danger'} mono" style="font-size: 8.5px;">${diff25vs24 >= 0 ? '+' : ''}${diff25vs24}%</span></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px;">
                        <span style="color: #8b5cf6; font-weight: 700;">● Tahun 2026 (YTD):</span>
                        <span class="mono fw-bold text-dark">${val2026 > 0 ? formatVal(val2026) : '-'} ${val2026 > 0 ? `<span class="badge ${diff26vs25 >= 0 ? 'bg-success' : 'bg-danger'} mono" style="font-size: 8.5px;">${diff26vs25 >= 0 ? '+' : ''}${diff26vs25}%</span>` : ''}</span>
                    </div>
                </div>
            `;
        }

